import assert from 'node:assert/strict';
import {Guest,SHIMS} from './guest.mjs';
import {OpBackend} from './d3d9-backend.mjs';
const g=new Guest({pages:512}),dll={meta:{spare_thunks:1024,thunk_base:0x13000000,imports:[]},extras:[]};
class Backend extends OpBackend{emit(){}}
g.d3d9Backend=new Backend();
const d3d=SHIMS['d3d9.dll!Direct3DCreate9'].fn.call({g,dll},32),rt=g.d3dRuntime;
const call=(obj,slot,...args)=>{const st=rt.objects.get(obj),fn=dll.extras.find(x=>x?.name===`d3d9#${st.kind}:${slot}`).fn;return fn.call({g,dll},obj,...args);};
const pp=g.alloc(56),out=g.alloc(4);g.u32(pp,64);g.u32(pp+4,64);g.u32(pp+8,21);g.u32(pp+32,1);
assert.equal(call(d3d,16,0,1,0,0,pp,out),0);const dev=g.u32(out);
assert.equal(call(dev,23,16,16,1,1,21,0,out),0);const tex=g.u32(out);
assert.equal(call(tex,18,0,out),0);const surface=g.u32(out),st=rt.objects.get(surface);g.d3d9Backend.ensure(st);
assert.equal(g.d3d9Backend.known.has(surface),true);call(surface,2);call(tex,2);
assert.equal(g.d3d9Backend.known.has(surface),false,'destroying a texture must invalidate child surface identities in the renderer');
console.log('PASS texture container and child renderer resource lifetime');
const device=rt.objects.get(dev),be=g.d3d9Backend;
be.stateDelta(device);const data=g.alloc(16);[1,2,3,4].forEach((v,i)=>g.dv.setFloat32(data+i*4,v,true));
assert.equal(call(dev,94,7,data,1),0);const delta=be.stateDelta(device);
assert.deepEqual(delta.d.cf,[[0,7,1]]);assert.deepEqual([...new Float32Array(delta.blob.buffer)],[1,2,3,4]);
assert.equal(be.stateDelta(device).d.cf,undefined);
console.log('PASS shader constant delta and unchanged-state suppression');
// Once consumed, untouched bindings must not be rescanned for every draw.
be.stateDelta(device);
const textures=device.tex,streams=device.streams;
const noIndices=a=>new Proxy(a,{get(t,k){if(/^\d+$/.test(String(k)))throw Error('unchanged binding scanned');return Reflect.get(t,k);}});
device.tex=noIndices(textures);device.streams=noIndices(streams);
assert.deepEqual(be.stateDelta(device).d,{});
device.tex=textures;device.streams=streams;
assert.equal(call(dev,23,16,16,1,0,21,0,out),0);const changedTex=g.u32(out);
assert.equal(call(dev,65,3,changedTex),0);
assert.deepEqual(be.stateDelta(device).d.tex,[[3,changedTex]]);
assert.equal(call(dev,26,128,0,0,0,out,0),0);const vb=g.u32(out);
assert.equal(call(dev,100,2,vb,12,24),0);
assert.deepEqual(be.stateDelta(device).d.streams,[[2,{vb,offset:12,stride:24,freq:1}]]);
console.log('PASS binding dirty masks skip untouched arrays and retain changed slots');
be.resize(640,480);
const resized=be.stateDelta(device).d;
assert.deepEqual(resized.tex,[[3,changedTex]],'resize replays bound textures after clearing the renderer mirror');
assert.equal(resized.streams[0][0],2);
assert.equal(call(dev,59,1,out),0);const block=g.u32(out);
call(dev,65,3,0);be.stateDelta(device);call(block,5);
assert.deepEqual(be.stateDelta(device).d.tex,[[3,changedTex]],'state block restore invalidates binding masks');
console.log('PASS resize and state-block binding replay');
assert.equal(call(dev,118,9,0)>>>0,0x8876086a,'unsupported occlusion queries must not be advertised');
g.u32(out,0xdeadbeef);assert.equal(call(dev,118,9,out)>>>0,0x8876086a);assert.equal(g.u32(out),0);
assert.equal(call(dev,118,8,out),0,'event-query support remains available');
console.log('PASS unsupported occlusion capability and event-query availability');
const constants=g.alloc(32),values=[9,8,7,6];values.forEach((v,i)=>g.dv.setFloat32(constants+4*i,v,true));
const getFloat=g.dv.getFloat32;
try{g.dv.getFloat32=()=>{throw Error('aligned constants must use bulk typed-array copies');};assert.equal(call(dev,94,9,constants,1),0);}finally{g.dv.getFloat32=getFloat;}
g.dv.setFloat32(constants,99,true);assert.equal(device.vsF[36],9,'setter snapshots the caller data');
values.forEach((v,i)=>g.dv.setFloat32(constants+1+4*i,v,true));assert.equal(call(dev,109,10,constants+1,1),0);
assert.deepEqual([...device.psF.subarray(40,44)],values,'unaligned constants retain legal D3D behavior');
console.log('PASS bulk constant snapshots and unaligned constant pointers');
