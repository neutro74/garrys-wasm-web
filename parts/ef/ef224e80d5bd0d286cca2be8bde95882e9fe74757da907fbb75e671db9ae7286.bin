"VertexLitGeneric"
{
     "$basetexture" "models\props_docks\waterdirectionalbouis"
     "$surfaceprop" "metal"
     "$envmap" "env_cubemap"	
     "$basealphaenvmapmask" 1
}"UnlitGeneric"
{
	"$basetexture"	"particle/water/WaterDrop_001a"
	"$vertexcolor" 1 
	"$vertexalpha" 1 
	$maxsize .85
	$startfadesize .675
	$endfadesize .75
}"UnlitGeneric"
{
	"$basetexture"	"particle/water/WaterDrop_001a"
	$Additive 1
	$Translucent 1
	$vertexcolor 1
	$vertexalpha 1
	$maxsize .85
	$startfadesize .675
	$endfadesize .75
}"Refract"
{
	"$normalmap" "particle/water/WaterDrop_001a_normal"
 	"$refractamount" "-.05"
	"$vertexalpha" "1"
	"$vertexcolor" "1"
	"$translucent" "1"
	"$forcerefract" 1
 	"$bluramount" "1"
	"$nofog" "1"
	"$vertexcolormodulate" "1"

}
