		"wave"		"ambient/levels/canals/water_rivulet_loop2.wav"
		"pitch"		"100"
	}	
	
}

// d1_canals_08a, The outdoor area where the ramp puzzle is.
"d1_canals_08a_puzzle_arena"
{
