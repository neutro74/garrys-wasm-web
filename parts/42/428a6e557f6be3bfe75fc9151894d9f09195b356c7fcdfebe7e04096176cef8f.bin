		"static_icon"
		{
			"x"			"144"
			"y"			"4"
			"w"			"16"
			"h"			"16"
			"name"		"icon_%(localteam)m_szTeamName%"
		}
			
		"static_text"
		{
			"size"		"medium"
			"align"		"left"
			"x"			"10"
			"y"			"18"
			"w"			"150"
			"text"		"Health:  - %(localplayer)m_iHealth% -"
		}
		
		"static_text"
		{
			"size"		"medium"
			"align"		"left"
			"x"			"10"
			"y"			"32"
			"w"			"150"
			"text"		"(weapon_print_name):  - (ammo_primary) -"
		}
	}
	
