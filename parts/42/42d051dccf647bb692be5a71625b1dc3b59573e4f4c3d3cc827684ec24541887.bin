export class GameAudio {
  constructor(ring){this.ring=ring;this.context=null;this.starting=null;const start=()=>this.start().catch(error=>console.error('[audio]',error));window.addEventListener('pointerdown',start,{capture:true});window.addEventListener('keydown',start,{capture:true});window.addEventListener('message',e=>{if(e.data?.__gmodHtml&&e.data?.type==='native-input'&&e.data.event?.type==='pointerdown')start();});}
  async start(){if(this.context){await this.context.resume();return;}if(this.starting)return this.starting;this.starting=(async()=>{const context=new AudioContext({sampleRate:44100,latencyHint:'interactive'});this.context=context;await context.audioWorklet.addModule(new URL('./audio-worklet.js', import.meta.url));this.node=new AudioWorkletNode(context,'gmod-audio',{numberOfInputs:0,numberOfOutputs:1,outputChannelCount:[2],processorOptions:{ring:this.ring}});if(this.memory)this.node.port.postMessage({memory:this.memory});this.node.connect(context.destination);await context.resume();console.log('[audio] output running',context.sampleRate);})();return this.starting;}
  setMemory(memory){this.memory=memory;this.node?.port.postMessage({memory});}
  stats(){const c=new Int32Array(this.ring,0,8);return {state:this.context?.state??'awaiting gesture',read:Atomics.load(c,0)>>>0,written:Atomics.load(c,1)>>>0,rate:Atomics.load(c,2),paused:Atomics.load(c,4),underruns:Atomics.load(c,6)>>>0,nonzero:Atomics.load(c,7)>>>0};}
}
