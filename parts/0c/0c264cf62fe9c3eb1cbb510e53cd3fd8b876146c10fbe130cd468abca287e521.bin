«¿ýÄ!␀ÿÿUÄ!␀ ÿÿUM*b/½õU,*Bø~_Uƒ␀␀¨ªÿUc␀␀êþ_]ƒ␀␀~_UU␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀b␀␀]VUUƒ␀␀ÕUUUƒ␀␀ÿUUUƒ␀␀WUUUƒ␀␀ýUUUƒ␀␀_UUU␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀//used in texture mode when a player is so close to a portal polygon that the renderer would clip by zNear. This is used on special polygons to cover up the clips.
"Portal"
{
	"$basetexture" "_rt_Portal1"
	"$renderfixz" "1" //depth buffer hacks
}"writez"
{
	"$alphamasktexture" "models/portals/portal_mask"
	"$bluramount" "1"
	"$bumpframe" 0
	"$translucent" 1
	"$additive" 1
}//Used in texture drawing mode to draw the surface of portal 2 (faking the view through it) when the player is close up or there's no fog in the level
"Portal"
{
	"$fogcompatible" "0" 							//flag that controls if the material is fog compatible. WARNING: Fog compatibility breaks portal drawing when the camera is near a portal polygon.
	"$basetexture" "_rt_Portal2" 						//portal 2's view
	"$alphamasktexture" "models/portals/portal_mask" 	//alpha mask for defining the portal's edges
}//Used in texture drawing mode to draw the surface of portal 2 (faking the view through it) when there's fog in the level and the player is far enough away that the projection math won't screw up
//this should look EXACTLY like portal_2_dynamicmesh.vmt with the exception of having "$fogcompatible" set to 1
"Portal"
{
	"$fogcompatible" "1" 							//flag that controls if the material is fog compatible. WARNING: Fog compatibility breaks portal drawing when the camera is near a portal polygon.
	"$basetexture" "_rt_Portal2" 						//portal 2's view
	"$alphamasktexture" "models/portals/portal_mask" 	//alpha mask for defining the portal's edges
}"UnlitGeneric"
{
	"$basetexture" "effects/portal_2_particle"
	"$additive" "1"
	"$vertexalpha" "1"
	"$vertexcolor" 1
	"$translucent" "1"
}
