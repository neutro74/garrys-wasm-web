.split-view {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    overflow: hidden;
}

.split-view-contents {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: auto;
    cursor: default;
}

.split-view-sidebar-left {
    border-right: 1px solid rgb(64%, 64%, 64%);
}

.split-view-sidebar-left.maximized {
    border-right: none;
}

.split-view-sidebar-right {
    border-left: 1px solid rgb(64%, 64%, 64%);
}

.split-view-sidebar-right.maximized {
    border-right: none;
}

.split-view-resizer {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5px;
    z-index: 500;
    cursor: ew-resize;
}

.sidebar-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 10;
    background-color: white;
    border-right: 1px solid gray;
    -webkit-box-shadow: rgb(90,90,90) 20px 0px 50px -25px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
}

.sidebar-overlay-resizer {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5px;
    z-index: 500;
    cursor: ew-resize;
}
