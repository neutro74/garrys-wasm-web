// from light fixture just past ladder up to silos to light fixture just BEFORE the ladder up to sideyard)
"militia.Tunnel2"
{
	"dsp"	"6"

	"playsoundscape"
	{
		"name" "militia.TunnelTone"
	}

	// 0: Light fixture hum
	"playsoundscape"
	{
		"positionoverride"	"0"
		"name"				"militia.LightbulbHum"
	}

