//------------------------------------------------------------------------------------------
//------------------------------------------------------------------------------------------
"inferno.TSpawn"
{
	"dsp"	"6"

	"playsoundscape"
	{
		"name" "inferno.Outside"
	}

	// Position 0: The Tree
	"playsoundscape"
	{
		"positionoverride"	"0"
		"name"				"inferno.Birds"
	}

	// Position 1: Trees outside in skybox
	"playsoundscape"
	{
		"positionoverride"	"1"
		"name"				"inferno.Birds"
	}

	// Position 2: The fountain
	"playlooping"
	{
		"position"		"2"	
		"pitch"			"100"
		"volume"		"0.3"
		"soundlevel"  	"SNDLVL_65dB"
		"wave"			"ambient/nature/water_gently_lapping.wav"
	}
	
	// Position 3: Locked dark door to the right
	"playlooping"
	{
		"position"		"3"	
		"pitch"			"100"
		"volume"		"0.55"
		"soundlevel"  	"SNDLVL_75dB"
		"wave"			"ambient/music/flamenco.wav"
	}

	// Position 4: Dark corner where the cactus is
	"playsoundscape"
	{
		"positionoverride"	"4"
		"name"				"inferno.Cricket"
	}
}



