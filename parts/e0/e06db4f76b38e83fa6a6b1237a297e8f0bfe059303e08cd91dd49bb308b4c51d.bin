	"NPC_Voice"				""					"NPC"		"CHAN_VOICE"	""			""			"50"		"0"		"1"		"100"	"40"
	"NPC_Weapons_Loud"		""					"NPC"		"CHAN_WEAPON"	"140"		""			"50"		"0"		"1"		"100"	"40"
