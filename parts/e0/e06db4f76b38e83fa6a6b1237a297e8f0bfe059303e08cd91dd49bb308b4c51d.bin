// de_nuke soundscapes
// Author: Chris Ashton, Turtle Rock Studios, Inc., August 2005


//------------------------------------------------------------------------------------------
//
// Generic outdoors ambience
//
"nuke.outside"
{
	// underlying area "tone"
	"playlooping"
	{
		"volume"	"0.5"
		"pitch"		"100"
		"wave"		"ambient/atmosphere/plaza_amb.wav"
	}

	// wind gusts
	"playrandom"
	{
		"time"		"15,30"
		"volume"	"0.08"
		"pitch"		"90,110"

		"rndwave"
		{
			"wave"	"ambient/wind/wind_med1.wav"
			"wave"	"ambient/wind/wind_med2.wav"
		}
	}

	// planes flying overhead
	"playrandom"
	{
		"time"		"10,50"
		"volume"	".05,.1"
		"pitch"		"90,100"

		"rndwave"
		{
			"wave"	"ambient/overhead/plane1.wav"
			"wave"	"ambient/overhead/plane2.wav"
			"wave"	"ambient/overhead/plane3.wav"
		}
	}
}

//------------------------------------------------------------------------------------------
//
// Generic roof ambience
//
"nuke.roof"
{
	// underlying area "tone"
	"playlooping"
	{
		"volume"	"0.6"
		"pitch"		"100"
		"wave"		"ambient/atmosphere/plaza_amb.wav"
	}

	// wind gusts
	"playrandom"
	{
		"time"		"5,10"
		"volume"	"0.2,0.5"
		"pitch"		"90,110"

		"rndwave"
		{
			"wave"	"ambient/wind/wind_med1.wav"
			"wave"	"ambient/wind/wind_med2.wav"
		}
	}

	// planes flying overhead
	"playrandom"
	{
		"time"		"10,50"
		"volume"	".05,.1"
		"pitch"		"90,100"

		"rndwave"
		{
			"wave"	"ambient/overhead/plane1.wav"
			"wave"	"ambient/overhead/plane2.wav"
			"wave"	"ambient/overhead/plane3.wav"
		}
	}

}

