"UnlitGeneric"
{
	"$baseTexture" "Effects/tp_eyefx/tp_eyefx_eli"
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" 8
		}
	}
}
"Refract"
{
 	"$model" 1
 	"$refractamount" ".2"
 	"$bluramount" "1"
	"$REFRACTTINT" "{255 212 121}"
	"$scale" "[1 1]"
	"$dudvmap" "dev/water_dudv"
 	"$normalmap" "dev/water_normal"
 	"$surfaceprop" "water"
	"$bumpframe" "0"
//	"$nocull" 1
	"$envmap" "env_cubemap"
	"$envmaptint" "[.1 .1 .1]"
	"$REFRACTTINTTEXTURE" "models/props_lab/glass_tint001"
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$normalmap"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 30.00
		}


		"TextureScroll"
		{
			"texturescrollvar" "$bumptransform"
			"texturescrollrate" .21
			"texturescrollangle" 90.00
		}

	}
}
"UnlitTwoTexture"
//"Modulate"
{
	"$baseTexture" "Models/props_combine/tpballglow"
	"$Texture2" "Models/props_combine/tpballglow2"
	"$nocull" "1"	
	"$nodecal" "1"
	"$additive" "1"
//	"$translucent" "1"
	"$no_fullbright" 1
	"$model" "1"
	"$nofog" "1"
//	"$MOD2X" "1"
	

	"Proxies"
	{
		"TextureScroll"
		{
			"texturescrollvar" "$texture2transform"
			"texturescrollrate" -1
			"texturescrollangle" 4
		}

}

