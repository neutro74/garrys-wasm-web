rule AlyxPassengerRequestEnterNearThanks
{
	criteria 	IsAlyx VehicleNear IsAlyxRequestEnter NotInCombat ConceptAlyxPassengerEntered IsNotAlyxRequestEnterThanks  PlayerReallyNear
	applycontext 	"AlyxRequestEnterThanks:1:60"
	response	"AlyxPassengerRequestEnterNearThanks"
}
//============================================================================================================
// Barney criteria
criterion "IsBarney" "classname" "npc_barney" "required"
criterion "ConceptTalkBarneyEscort" "Concept" "TLK_BARNEY_ESCORT" required
criterion "BarneyGetOnTrainGordon" "Concept" "ConceptBarneyGetOnTrainNag" required
criterion "IsSniperFire" "Concept" "ConceptSniperFire" required
criterion "FoughtSniper" "SniperAction" "1" required
criterion "IsMap_ep1_c17_05" "map" "ep1_c17_05" weight 10 "required"
//============================================================================================================



//============================================================================================================
// Barney Escort Speech
//============================================================================================================
//----------------------------------------------------------------------------

response "BarneyEscort"
{
	scene "scenes/episode_1/barn_c17_05_defendthecitizens.vcd"
	scene "scenes/episode_1/barn_c17_05_followfreeman.vcd"
	scene "scenes/episode_1/barn_c17_05_theseareourpeople.vcd"
	scene "scenes/episode_1/barn_c17_05_thenextgroupisready.vcd"
	scene "scenes/episode_1/barn_c17_05_runthisgrouptothetrain.vcd"
	scene "scenes/episode_1/barn_c17_05_keepthemsafe.vcd"
	scene "scenes/episode_1/barn_c17_05_protectthecitizens.vcd"
	scene "scenes/episode_1/barn_c17_05_moveemout.vcd"
	scene "scenes/episode_1/barn_c17_05_takethesefolkstothetrain.vcd"
	scene "scenes/episode_1/barn_c17_05_takethemtothetrain.vcd"
	scene "scenes/episode_1/barn_c17_05_theyregettingaboard.vcd"
	scene "scenes/episode_1/barn_c17_05_followfreeman.vcd"

}
rule BarneyEscort
{
	criteria IsBarney ConceptTalkBarneyEscort
	response BarneyEscort
}


response "BarneyEscortSniper"
{
	scene "scenes/episode_1/c17/ba_gordoniknow.vcd"

}
rule BarneyEscortSniper
{
	criteria IsBarney ConceptTalkBarneyEscort FoughtSniper
	response BarneyEscortSniper
}


//============================================================================================================
// Barney Screaming During Sniper Scene
//============================================================================================================
//----------------------------------------------------------------------------

response "BarneySniperYell"
{
	norepeat
	scene "scenes/episode_1/c17/ba_duck.vcd" respeakdelay 30
	scene "scenes/episode_1/c17/ba_getdown.vcd" respeakdelay 30	
	
}
rule BarneySniperYell
{
	criteria IsBarney IsSniperFire 
        applycontext "SniperAction:1:180"
	response BarneySniperYell
}



//============================================================================================================
// Barney Not Looking Dead While Herding the Citizens
//============================================================================================================
//----------------------------------------------------------------------------
criterion "NotUsedBarneyResponse" "UsedBarneyResponse" "!=1" "required" weight 0
criterion "IsUsedBarneyResponse" "UsedBarneyResponse" "1" "required" weight 0


response "BarneyUseHerdingCitizens"
{
	scene "scenes/episode_1/barn_c17_05_defendthecitizens.vcd"
	scene "scenes/episode_1/barn_c17_05_moveemout.vcd"  

	
}
rule BarneyUseHerdingCitizens
{
	criteria IsBarney ConceptTalkUse IsMap_ep1_c17_05 NotUsedBarneyResponse 
	applycontext "UsedBarneyResponse:1:30"
	response BarneyUseHerdingCitizens
}


response "BarneyUsedHerdingCitizens"
{
	scene "scenes/npc/barney/ba_use_default01.vcd" respeakdelay 5
	  	
}
rule BarneyUsedHerdingCitizens
{
	criteria IsBarney ConceptTalkUse IsMap_ep1_c17_05 IsUsedBarneyResponse  
	response BarneyUsedHerdingCitizens
}//============================================================================================================
// Citizen criteria
//============================================================================================================
criterion "IsCitizen" "classname" "npc_citizen" "required"
criterion "IsRPGUser" "attacking_with_weapon" "weapon_rpg" required
criterion "EnemyIsSniper" "enemy" "npc_sniper" required
criterion "EnemyIsStrider" "enemy" "npc_strider" required
criterion "HurtByFire" "hurt_by_fire" "1" required
criterion "AlyxCitizenHelloOkay" "AlyxCitizenHelloOkay" "1" required


criterion "NotInPanic" "readiness" "!panic" required
//cit response groups
criterion "RGroupLess10"            "randomnum"               "<=10"   required
criterion "RGroupLess20"            "randomnum"               "<=20"   required
criterion "RGroupLess30"            "randomnum"               "<=30"   required
criterion "RGroupLess40"            "randomnum"               "<=40"   required
criterion "RGroupLess50"            "randomnum"               "<=50"   required
criterion "RGroupLess60"            "randomnum"               "<=60"   required
criterion "RGroupLess70"            "randomnum"               "<=70"   required
criterion "RGroupLess80"            "randomnum"               "<=80"   required
criterion "RGroupLess90"            "randomnum"               "<=90"   required
criterion "RGroupLess100"           "randomnum"               "<=100"  required
criterion "RGroupMore00"            "randomnum"               ">0"    required
criterion "RGroupMore10"            "randomnum"               ">10"   required
criterion "RGroupMore20"            "randomnum"               ">20"   required
criterion "RGroupMore30"            "randomnum"               ">30"   required
criterion "RGroupMore40"            "randomnum"               ">40"   required
criterion "RGroupMore50"            "randomnum"               ">50"   required
criterion "RGroupMore60"            "randomnum"               ">60"   required
criterion "RGroupMore70"            "randomnum"               ">70"   required
criterion "RGroupMore80"            "randomnum"               ">80"   required
criterion "RGroupMore90"            "randomnum"               ">90"   required




//============================================================================================================
// Citizen Hello speech
//============================================================================================================
response "CitizenHello"
{
	scene "scenes/npc/$gender01/abouttime01.vcd"
	scene "scenes/npc/$gender01/abouttime02.vcd"
	scene "scenes/npc/$gender01/ahgordon01.vcd"
	scene "scenes/npc/$gender01/ahgordon02.vcd"
	scene "scenes/npc/$gender01/docfreeman01.vcd"
	scene "scenes/npc/$gender01/docfreeman02.vcd"
	scene "scenes/npc/$gender01/freeman.vcd"
	scene "scenes/npc/$gender01/hellodrfm01.vcd"
	scene "scenes/npc/$gender01/hellodrfm02.vcd"
	scene "scenes/npc/$gender01/heydoc01.vcd"
	scene "scenes/npc/$gender01/heydoc02.vcd"
	scene "scenes/npc/$gender01/hi01.vcd"
	scene "scenes/npc/$gender01/hi02.vcd"
}

rule CitizenHello
{
	criteria		IsCitizen ConceptTalkHello IsGordonCriminal PlayerNear SeePlayer NotInPanic
	response		CitizenHello
}

//============================================================================================================
// Citizen Idle speech
//============================================================================================================
response "CitizenTalkStare"
{
 scene "scenes/npc/$gender01/doingsomething.vcd"
 scene "scenes/npc/$gender01/getgoingsoon.vcd"
 scene "scenes/npc/$gender01/waitingsomebody.vcd"
}
 
rule CitizenTalkStare
{
 criteria      IsCitizen ConceptTalkStare IsGordonCriminal NPCIdle NotInPanic
 response  	CitizenTalkStare
}
 

//------------------------------------------------------------------------------------------------------------
response "CitizenTalkPlayerPushed"
{
   scene "scenes/npc/$gender01/sorryfm01.vcd"
   scene "scenes/npc/$gender01/sorryfm02.vcd"
   scene "scenes/npc/$gender01/sorrydoc01.vcd"
   scene "scenes/npc/$gender01/sorrydoc02.vcd"
   scene "scenes/npc/$gender01/sorrydoc04.vcd"
   scene "scenes/npc/$gender01/excuseme01.vcd"
   scene "scenes/npc/$gender01/excuseme02.vcd"
   scene "scenes/npc/$gender01/pardonme01.vcd"
   scene "scenes/npc/$gender01/pardonme02.vcd"
   scene "scenes/npc/$gender01/sorry01.vcd"
   scene "scenes/npc/$gender01/sorry02.vcd"
   scene "scenes/npc/$gender01/sorry03.vcd"
   scene "scenes/npc/$gender01/outofyourway01.vcd"
   scene "scenes/npc/$gender01/outofyourway02.vcd"
   scene "scenes/npc/$gender01/whoops01.vcd"
}

rule CitizenTalkPlayerPushed
{
	criteria		IsCitizen  ConceptTalkPlayerPushed SeenByPlayer NoRecentCombat
	response		CitizenTalkPlayerPushed
}

