criterion "ConceptGetInCar09" "Concept" "TLK_OUTLAND_09_GETINCAR" required

response Alyx_GetInCar09
{
	SEQUENTIAL
	NOREPEAT
	scene "scenes/npc/alyx/al_vehicle_combat_playernotincar_nag01.vcd"
