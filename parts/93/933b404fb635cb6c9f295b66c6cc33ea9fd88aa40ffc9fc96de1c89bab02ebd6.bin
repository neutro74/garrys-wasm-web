    var filter = "function(edge) {\n" +
        "    return !edge.isInvisible\n" +
        "        && (" + !tree.showRetainingEdges + " || (edge.node.id !== 1 && !edge.node.isSynthetic))\n" +
        "        && (" + showHiddenData + " || (!edge.isHidden && !edge.node.isHidden));\n" +
