	"$abovewater" "0"
	"%compilewater" "1"
	"$forceexpensive" "1"
	"$reflectentities" "0"
	"%tooltexture" "nature/water_coast01_normal"
	"$refracttexture" "_rt_WaterRefraction"
	"$refractamount" "1"

