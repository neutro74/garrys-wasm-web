	scene "scenes/episode_1/npc/$gender01/cit_alert_antlions18.vcd" respeakdelay 30
}

rule CitizenAntLionDanger
{
	criteria		IsCitizen ConceptTalkAttacking EnemyIsAntLion
	response		CitizenAntLionDanger  
}





