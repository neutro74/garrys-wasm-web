import assert from 'node:assert/strict';
import {installInput} from './win32-input.mjs';
const S={};installInput(S);
const bytes=new Uint8Array(8192),dv=new DataView(bytes.buffer),g={u8:bytes,dv,userWindows:new Map([[1,{proc:100}]]),u32(p,v){if(v!==undefined)dv.setUint32(p,v,true);return dv.getUint32(p,true);},dlls:new Map([['test',{meta:{base:0,size:1000}}]]),call(d,p,a){return a[1];}};
let events=[{type:'key',vk:65,scan:30,down:true,char:'a'},{type:'move',x:50,y:60}];g.inputPoll=()=>events.splice(0);
const call=(n,...args)=>S['user32.dll!'+n].fn.call({g},...args);
assert.equal(call('PeekMessageW',1000,0,0,0,0),1);
assert.equal(g.u32(1004),0x100);
assert.equal(call('PeekMessageW',1000,0,0,0,1),1);
assert.equal(call('GetKeyState',65)&0x8000,0x8000);
call('TranslateMessage',1000);
assert.equal(call('DispatchMessageW',1000),0x100);
assert.equal(call('PeekMessageW',1000,0,0x102,0x102,1),1);
assert.equal(g.u32(1008),97);
events=[{type:'focus',focused:false}];
call('GetCursorPos',2000);assert.equal(g.u32(2000),50);assert.equal(call('GetKeyState',65),0);
console.log('input ring drain, message filters, peek, text, dispatch, focus: PASS');
g.u32(2100,0x00020001);g.u32(2104,0);g.u32(2108,1);
assert.equal(call('RegisterRawInputDevices',2100,1,12),1);
events=[{type:'move',relative:true,dx:12,dy:-4}];
assert.equal(call('PeekMessageW',1000,0,0xff,0xff,1),1);
g.u32(2200,0);assert.equal(call('GetRawInputData',g.u32(1012),0x10000003,0,2200,16),0);assert.equal(g.u32(2200),40);
g.u32(2200,40);assert.equal(call('GetRawInputData',g.u32(1012),0x10000003,2300,2200,16),40);assert.equal(g.u32(2328),12);assert.equal(g.u32(2332),(-4)>>>0);
console.log('raw mouse packet layout: PASS');
S['user32.dll!DefWindowProcW']={fn:()=>123};g.dlls.set('thunk',{meta:{base:20000,size:100,thunk_base:0x13000000,imports:[{dll:'user32.dll',name:'DefWindowProcW'}]}});
assert.equal(call('CallWindowProcW',0x13000000,1,0x200,0,0),123);
console.log('imported window procedure delegation: PASS');
// During a D3D mode reset the engine temporarily clears keyboard focus. This must
// not deactivate the app: GetActiveWindow/GetForegroundWindow still name its window.
call('SetForegroundWindow',1);
assert.equal(call('SetFocus',0),1);
assert.equal(call('GetFocus'),0);
assert.equal(call('GetActiveWindow'),1,'clearing keyboard focus must not deactivate the game');
assert.equal(call('GetForegroundWindow'),1);
assert.equal(call('SetFocus',1),0);
assert.equal(call('GetFocus'),1);
console.log('keyboard focus and application activation remain independent: PASS');
g.userWindows.set(1,{proc:100,x:10,y:20,w:1280,h:720});
assert.equal(call('SetWindowPos',1,0,30,40,640,480,0),1);
call('GetClientRect',1,2500);assert.equal(g.u32(2508),640);assert.equal(g.u32(2512),480);
call('GetWindowRect',1,2500);assert.equal(g.u32(2500),30);assert.equal(g.u32(2504),40);assert.equal(g.u32(2508),670);
g.u32(2600,5);g.u32(2604,6);call('ClientToScreen',1,2600);assert.equal(g.u32(2600),35);assert.equal(g.u32(2604),46);
call('ScreenToClient',1,2600);assert.equal(g.u32(2600),5);assert.equal(g.u32(2604),6);
call('SetWindowPos',1,0,0,0,1,1,3);call('GetClientRect',1,2500);assert.equal(g.u32(2508),640);
console.log('window resize, client bounds, coordinate conversion and SWP flags: PASS');
events=[{type:'move',x:50,y:60}];call('GetCursorPos',2600);assert.equal(g.u32(2600),80);assert.equal(g.u32(2604),100);
call('ScreenToClient',1,2600);assert.equal(g.u32(2600),50);assert.equal(g.u32(2604),60);
call('SetCursorPos',130,140);call('GetCursorPos',2600);assert.equal(g.u32(2600),130);assert.equal(g.u32(2604),140);
console.log('browser client mouse coordinates roundtrip through Win32 screen coordinates: PASS');
