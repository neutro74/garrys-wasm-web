	{
		"name"		"ep1_citadel.util_activity"
		"volume"	"1.0"
	}


	"playrandom"
	{
		"time"		"30, 60"
		"volume"	"0.15,0.25"
		"pitch"		"90,110"
		"position"	"random"
		"soundlevel"	"SNDLVL_140db"
		"rndwave"
		{
			"wave"	"*ambient/levels/citadel/citadel_ambient_voices1.wav"
		}
	}
}

