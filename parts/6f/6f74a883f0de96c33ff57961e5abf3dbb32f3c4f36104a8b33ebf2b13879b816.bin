	criteria AlyxGetToTrain PlayerNear
	response GetToTrain
}
// Barney nags for episodic
criterion "IsWaitForPlayerToLeave" "concept" "LeaveBarneyRoom" "required"
criterion "IsAPC05" "concept" "BarneyPlayerAPCKill05" "required"


//============================================================================================================
// Nags to get player to leave Barney's raid room in c17_02
//============================================================================================================
response "Response_LeaveBarneyRoom"
{
	scene "scenes/episode_1/ba_c17_02_leavenag_01.vcd"
}

rule Rule_LeaveBarneyRoom
{
	criteria		IsWaitForPlayerToLeave
	response		Response_LeaveBarneyRoom
}


//============================================================================================================
// Nags to stop player from thinking citizens will come with them until apcs are gone.
//============================================================================================================
response "BarneyAPCNag"
{	
	sequential
	norepeat
	scene "scenes/episode_1/c17/ba_killapc03.vcd"
	scene "scenes/episode_1/c17/ba_killapc02.vcd"
	scene "scenes/episode_1/c17/ba_killapc01.vcd"
}

rule BarneyAPCNag
{
	criteria		IsAPC05
	response		BarneyAPCNag
}

//============================================================================================================
// Alyx criteria
criterion "IsAlyx" "classname" "npc_alyx" "required"
//============================================================================================================

//============================================================================================================
// Alyx Combat speech
//============================================================================================================
//----------------------------------------------------------------------------

criterion "ConceptTalkFoundPlayer" "Concept" "TLK_FOUNDPLAYER" required

response "AlyxIsBack"
{
	// speak "*vo/episode_1/npc/alyx/al_greet_cit15.wav"  // I'm the person who's telling you to get moving.
}

rule AlyxIsBack
{
	criteria IsAlyx IsEpisodic ConceptTalkFoundPlayer
	response AlyxIsBack
}

criterion "PlayerNotUsingPhysCannon" "playerweapon"  "!=weapon_physcannon" required
response "AlyxDanger"
{
	scene "scenes/npc/Alyx/getback01.vcd"
	scene "scenes/npc/Alyx/getback02.vcd"  
//	scene "scenes/npc/Alyx/watchout01.vcd"  WATCH OUT!!! 
//	scene "scenes/npc/Alyx/watchout02.vcd" WATCH OUT!!! 
}
rule AlyxDanger
{
	criteria IsAlyx ConceptTalkDanger PlayerNotUsingPhysCannon 
	response AlyxDanger
}

response AlyxShot
{
   scene "scenes/npc/Alyx/gasp02.vcd" respeakdelay 30
   scene "scenes/npc/Alyx/gasp03.vcd" respeakdelay 30
   scene "scenes/npc/Alyx/hurt04.vcd" respeakdelay 30 
   scene "scenes/npc/Alyx/hurt05.vcd" respeakdelay 30
   scene "scenes/npc/Alyx/hurt06.vcd" respeakdelay 30
   scene "scenes/npc/Alyx/hurt08.vcd" respeakdelay 30
   scene "scenes/npc/Alyx/uggh01.vcd" respeakdelay 30
}

rule AlyxShot
{
   criteria    IsAlyx ConceptShot
   response    AlyxShot
}


