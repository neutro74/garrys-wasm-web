// play when core is stabilized

"ep1_citadel.stabilized_core"
{

	"dsp"	"1"

	"playsoundscape"
	{
		"name"	"ep1_citadel.util_hits"
		"volume"	"0.6"
	}

	"playlooping"
	{
		"volume"	"0.45"
		"pitch"		"100"
		"wave"		"ambient/levels/citadel/citadel_sickdrone_loop1.wav"
	}

	
	"playrandom"
	{
		"time"		"3,5"
		"volume"	"0.3, 0.55"
		"pitch"		"95,105"
		"position"	"random"
		"soundlevel"	"SNDLVL_140db"
		"rndwave"
