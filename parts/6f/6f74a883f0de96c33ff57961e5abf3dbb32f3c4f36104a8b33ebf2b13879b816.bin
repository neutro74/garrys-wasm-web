// play when in an area with a deep vertical shaft

"ep1_citadel.deep_dropoff_inside"
{
	"dsp"	"1"

	"playlooping"
	{
		"volume"	"0.4"
		"pitch"		"100"
		"wave"		"ambient/levels/citadel/citadel_sickdrone_loop4.wav"
